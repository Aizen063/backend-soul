API_BASE=https://backend-soul.onrender.com
IMPORT_TOKEN=replace-with-admin-jwt

# ─── Spotify Import (optional but recommended) ────────────────────────────────
# Enables track/album/playlist import from Spotify URLs.
# Get free credentials (no credit card) at https://developer.spotify.com/dashboard
# 1. Create an app  →  copy Client ID and Client Secret below
# 2. Without these, only single Spotify track URLs work (title/artist parsed from URL)
#    and album/playlist imports are disabled.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ─── Optional ─────────────────────────────────────────────────────────────────
# Keep temporary downloads in a custom local folder
# IMPORT_DOWNLOAD_DIR=C:\\temp\\soul-sound-imports

# Optional: YouTube cookies for yt-dlp (helps with age-restricted videos)
# Use ONE option below:
# YTDLP_COOKIE_FILE=/absolute/path/to/cookies.txt
# YTDLP_COOKIES_B64=base64_encoded_netscape_cookie_file
# YTDLP_COOKIES_TEXT=raw_netscape_cookie_file_contents
